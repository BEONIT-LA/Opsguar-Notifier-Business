# ═══════════════════════════════════════════════════════════════
# PLANTILLA — no se aplica con `kubectl apply -f .` (extensión .example).
#
# Recomendado: crear el Secret sin escribir valores en archivos, con los
# datos sacados de Gravity Ops (ver README.md):
#
#   kubectl create secret generic opsguard-secrets -n opsguard #     --from-literal=POSTGRES_PASS="$POSTGRES_PASS" #     --from-literal=JWT_SECRET="$(openssl rand -hex 32)" #     --from-literal=ADMIN_PASS="$ADMIN_PASS"
#
# Si prefieres el manifiesto: copia a 01-secrets.yaml (está en .gitignore),
# rellena con `echo -n "valor" | base64` y aplícalo. No lo subas al repo.
# ═══════════════════════════════════════════════════════════════
apiVersion: v1
kind: Secret
metadata:
  name: opsguard-secrets
  namespace: opsguard
type: Opaque
data:
  POSTGRES_PASS: <base64>   # obligatoria
  JWT_SECRET: <base64>      # obligatoria, 32+ caracteres (openssl rand -hex 32)
  ADMIN_PASS: <base64>      # opcional: clave del primer superadmin (12+ caracteres)
