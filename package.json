{
  "name": "opsguar-notifier-business",
  "version": "2.0.0",
  "description": "Opsguar-Notifier Business — plataforma multiempresa de notificaciones WhatsApp (multi-tenant): el admin crea tenants con cuota/vigencia, cada responsable gestiona sus sesiones, grupos y tokens de API.",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "ui:dev": "cd frontend && npm run dev",
    "ui:build": "cd frontend && npm run build",
    "ui:install": "cd frontend && npm install",
    "start": "node server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "testTimeout": 15000,
    "setupFiles": ["./tests/setup.js"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.20",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pino": "^10.0.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
