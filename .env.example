# Copia a .env y rellena. Los valores reales viven en Gravity Ops, no en el repo.
# Sin defaults: docker compose no arranca si faltan las obligatorias.

# Obligatoria
POSTGRES_PASS=
# Obligatoria, 32+ caracteres:  openssl rand -hex 32
JWT_SECRET=

# Primer superadmin (sólo se usa si la BD no tiene ninguno)
ADMIN_USER=admin
# Opcional, 12+ caracteres. Vacía → se genera una y sale UNA vez en el log.
ADMIN_PASS=
